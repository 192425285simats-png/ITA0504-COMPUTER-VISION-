
import cv2
import matplotlib.pyplot as plt

# Step 1: Read the image
img = cv2.imread("image.jpg")

if img is None:
    print("Error: Image not found!")
else:
    # Step 2: Convert the image to grayscale
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    # Step 3: Apply histogram equalization
    equalized = cv2.equalizeHist(gray)

    # Step 4: Display original and equalized images
    plt.figure(figsize=(10, 5))

    plt.subplot(2, 2, 1)
    plt.imshow(gray, cmap="gray")
    plt.title("Original Grayscale Image")
    plt.axis("off")

    plt.subplot(2, 2, 2)
    plt.imshow(equalized, cmap="gray")
    plt.title("Histogram Equalized Image")
    plt.axis("off")

    # Step 5: Compare histograms
    plt.subplot(2, 2, 3)
    plt.hist(gray.ravel(), 256, [0, 256], color="blue")
    plt.title("Original Histogram")

    plt.subplot(2, 2, 4)
    plt.hist(equalized.ravel(), 256, [0, 256], color="green")
    plt.title("Equalized Histogram")

    plt.tight_layout()
    plt.show()

    # Step 6: Save the equalized image
    cv2.imwrite("equalized_image.jpg", equalized)
    print("Histogram equalization completed successfully!")

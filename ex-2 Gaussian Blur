
import cv2

# Step 1: Read the image
img = cv2.imread("image.jpg")

# Step 2: Check whether the image is loaded
if img is None:
    print("Error: Image not found!")
else:
    # Step 3: Apply Gaussian Blur
    blurred_img = cv2.GaussianBlur(img, (15, 15), 0)

    # Step 4: Display the original image
    cv2.imshow("Original Image", img)

    # Step 5: Display the blurred image
    cv2.imshow("Gaussian Blurred Image", blurred_img)

    # Step 6: Save the blurred image
    cv2.imwrite("blurred_image.jpg", blurred_img)

    # Wait for a key press and close windows
    cv2.waitKey(0)
    cv2.destroyAllWindows()


import cv2
import matplotlib.pyplot as plt

def analyze_histogram(image_path):
    # Step 1: Read the input image
    img = cv2.imread(image_path)

    if img is None:
        print("Error: Image not found!")
        return

    # Step 2: Define color channels
    colors = ('b', 'g', 'r')
    channel_names = ('Blue', 'Green', 'Red')

    # Step 3: Display the original image
    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

    plt.figure(figsize=(12, 5))

    plt.subplot(1, 2, 1)
    plt.imshow(img_rgb)
    plt.title("Original Image")
    plt.axis("off")

    # Step 4: Calculate and plot histograms
    plt.subplot(1, 2, 2)

    for color, name in zip(colors, channel_names):
        hist = cv2.calcHist(
            [img], [colors.index(color)], None, [256], [0, 256]
        )
        plt.plot(hist, color=color, label=name)

    plt.title("Color Histogram")
    plt.xlabel("Pixel Intensity (0-255)")
    plt.ylabel("Number of Pixels")
    plt.xlim([0, 256])
    plt.legend()
    plt.grid(True)

    # Step 5: Display the result
    plt.tight_layout()
    plt.show()

# Function call
analyze_histogram("image.jpg")


import cv2

# Step 1: Read the input image
img = cv2.imread("image.jpg")

if img is None:
    print("Error: Image not found!")
else:
    # Step 2: Get original dimensions
    height, width = img.shape[:2]
    print("Original size:", width, "x", height)

    # Step 3: Resize to a bigger size (2 times)
    bigger = cv2.resize(
        img, None, fx=2, fy=2,
        interpolation=cv2.INTER_CUBIC
    )

    # Step 4: Resize to a smaller size (half)
    smaller = cv2.resize(
        img, None, fx=0.5, fy=0.5,
        interpolation=cv2.INTER_AREA
    )

    # Step 5: Display all images
    cv2.imshow("Original Image", img)
    cv2.imshow("Bigger Image", bigger)
    cv2.imshow("Smaller Image", smaller)

    # Step 6: Save resized images
    cv2.imwrite("bigger_image.jpg", bigger)
    cv2.imwrite("smaller_image.jpg", smaller)

    # Step 7: Wait and close windows
    cv2.waitKey(0)
    cv2.destroyAllWindows()
